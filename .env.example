# 复制成 .env 后填写。.env 已在 .gitignore 里，不要提交到公开仓库。

# DeepSeek 开放平台 Key，OpenAI 兼容协议
DEEPSEEK_API_KEY=sk-你的key

# 接口地址：DeepSeek 官方；换别家或本地服务时只改这一行
HA_BASE_URL=https://api.deepseek.com/v1

# 模型分工：主力生成用快模型，评测裁判用强模型
# 当前 DeepSeek 只有这两个模型，用 GET /models 可以随时确认
HA_MODEL_MAIN=deepseek-flash
HA_MODEL_REASONER=deepseek-v4-pro

# 隐私模式：打开后所有调用切到本地 OpenAI 兼容服务（如 Ollama / vLLM），聊天内容不出本机
HA_PRIVACY_MODE=0
HA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
HA_LOCAL_MODEL=qwen2.5:7b-instruct

# 离线桩：设为 1 时不调用任何模型，用占位输出把流程跑通
HA_OFFLINE=0

# 对话要不要走工具循环（查人 / 查记录 / 查我的事实）。0 = 旧的单次调用
HA_AGENT_TOOLS=1
# 对话要不要开思考模式。默认关：更快更便宜，也避开 reasoning_content 回传的坑
HA_AGENT_THINKING=0
# 本次进程花费超过这个数（美元）就自动降级为不带工具的单次回答
HA_SESSION_BUDGET=0.05

# 可选：数据库路径
# HA_DB_PATH=data/kb.sqlite3

# 聊天记录里代表「我」的昵称，导入时自动识别
HA_SELF_NAME=
